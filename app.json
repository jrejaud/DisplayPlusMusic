{
  "package_id": "space.alastor.jellyfinmusic",
  "edition": "202601",
  "name": "Jellyfin Music",
  "author": "jrejaud",
  "version": "3.1.1",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "tagline": "Jellyfin now-playing and transport control",
  "description": "Shows what Jellyfin is playing on the glasses — album art, progress and synced lyrics — and drives play/pause, next and previous on the selected Jellyfin player. Fork of DisplayPlus Music by Oliemanq.",
  "permissions": [
    {
      "name": "network",
      "desc": "This app needs to access the network in order to get music information and lyrics.",
      "whitelist": [
        "https://oliemanq.github.io/DisplayPlusMusic",
        "https://oliemanq.github.io/DisplayPlusMusic/",
        "https://accounts.spotify.com/authorize",
        "https://accounts.spotify.com/api/token",
        "https://api.spotify.com/v1/",
        "https://api.spotify.com/v1/me/player",
        "https://api.spotify.com/v1/me/player/queue",
        "https://api.spotify.com/v1/me/player/play",
        "https://api.spotify.com/v1/me/player/pause",
        "https://api.spotify.com/v1/me/player/next",
        "https://api.spotify.com/v1/me/player/previous",
        "https://i.scdn.co",
        "https://lrclib.net/api/get",
        "https://media.alastor.space",
        "https://ko-fi.com/oliemanq"
      ]
    }
  ],
  "supported_languages": [
    "en"
  ]
}
